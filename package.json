{
  "name": "wadahdb-studio",
  "private": true,
  "description": "An open-source Linux desktop client for MySQL and MariaDB",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/namilabs/wadahdb-studio.git"
  },
  "bugs": {
    "url": "https://github.com/namilabs/wadahdb-studio/issues"
  },
  "homepage": "https://github.com/namilabs/wadahdb-studio#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "desktop:dev": "wails dev -tags webkit2_41",
    "desktop:build": "wails build -tags webkit2_41",
    "desktop:appimage": "bash scripts/appimage.sh"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0"
  }
}
